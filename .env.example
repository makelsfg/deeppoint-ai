# 开发环境配置
NODE_ENV=development

# AI 对话模型 provider: glm | openai | ollama | lmstudio
AI_PROVIDER=glm

# Embedding provider 默认跟随 AI_PROVIDER；如需单独指定可取消注释
# EMBEDDING_PROVIDER=glm
# EMBEDDING_MODEL=

# 智谱 AI GLM 配置
# 注册地址: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL_NAME=glm-4.6
GLM_USE_THINKING=true
GLM_EMBEDDING_MODEL=embedding-3

# OpenAI / OpenAI-compatible 云端配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama 本地模型配置
# 先运行: ollama pull llama3.1 && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_API_KEY=

# LM Studio 本地模型配置
# 需在 LM Studio 中启动 OpenAI-compatible server，并加载 chat/embedding 模型
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_EMBEDDING_MODEL=local-embedding-model
LM_STUDIO_API_KEY=

# AI 产品建议可单独覆盖模型；留空则使用对应 provider 默认模型
AI_PRODUCT_MODEL_NAME=

# AI 请求超时（毫秒）。thinking 模式长文本分析单次可能要 100s 以上，超时会退化为兜底结果
AI_REQUEST_TIMEOUT_MS=60000
AI_ANALYSIS_TIMEOUT_MS=300000
AI_PRODUCT_TIMEOUT_MS=180000

# 小红书 Cookie 配置 (使用小红书数据源时需要)
# 登录小红书网页版后从浏览器开发者工具获取
XHS_COOKIE=your_xiaohongshu_cookie_here

# 浏览器配置
# 设置为 true 使用无头模式（服务器环境推荐）
HEADLESS=false

# Python 配置
PYTHONIOENCODING=utf-8
# 使用 scripts/setup-local.ps1 后会自动写入 .env.local
# PYTHON_PATH=.venv/Scripts/python.exe

# 任务运行时配置
DEEPPOINT_JOB_DATA_DIR=.deeppoint/jobs
DEEPPOINT_MAX_CONCURRENT_JOBS=1
# 需覆盖「抓取 + 逐聚类串行 AI 分析」的总耗时（单聚类约 1-2 分钟）
DEEPPOINT_JOB_TIMEOUT_MS=3600000

# 日志级别 (info/debug/error)
LOG_LEVEL=info
